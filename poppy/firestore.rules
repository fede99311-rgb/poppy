rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Bebè: visibile e modificabile solo dai membri.
    match /babies/{babyId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;

      allow create: if request.auth != null
        && request.resource.data.members.size() == 1
        && request.auth.uid in request.resource.data.members;

      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members
        || (
          // un nuovo membro entra aggiungendo solo se stesso e presentando un codice valido
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinCode'])
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.babyId == babyId
        )
      );

      allow delete: if request.auth != null && request.auth.uid in resource.data.members;

      match /entries/{entryId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/babies/$(babyId)).data.members;
      }
    }

    // Inviti: si legge un codice alla volta (niente elenco).
    match /invites/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in getAfter(/databases/$(database)/documents/babies/$(request.resource.data.babyId)).data.members;
      allow delete: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/babies/$(resource.data.babyId)).data.members;
    }
  }
}
